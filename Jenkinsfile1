pipeline {
    agent any
    
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/BhushaN625/Book-My-Show.git'
            }
        }
        
        stage('Build Docker') {
            steps {
                sh 'docker build -t bhushankusale/bms:latest -f bookmyshow-app/Dockerfile bookmyshow-app'
            }
        }
        
        stage('Deploy') {
            steps {
                sh ''' 
                docker stop bms || true
                docker rm bms || true
                docker run -d --name bms -p 3000:3000 bhushankusale/bms:latest
                '''
            }
        }
    }
}
